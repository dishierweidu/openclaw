# OpenClaw Docker Configuration
# Copy this file to .env and customize as needed
# Run: cp .env.example .env

# ============================================================
# Core Configuration
# ============================================================

# OpenClaw config directory (stores credentials, sessions, etc.)
OPENCLAW_CONFIG_DIR=${HOME}/.openclaw

# Workspace directory for agent operations
OPENCLAW_WORKSPACE_DIR=${HOME}/.openclaw/workspace

# Gateway authentication token (auto-generated if not set)
# OPENCLAW_GATEWAY_TOKEN=your-64-char-hex-token

# Skip interactive onboarding (1 = skip, create config automatically)
OPENCLAW_SKIP_ONBOARD=0

# ============================================================
# Network & Ports
# ============================================================

# Gateway bind mode: loopback (local), lan (0.0.0.0), tailnet, auto
OPENCLAW_GATEWAY_BIND=lan

# Gateway WebSocket/HTTP port (Control UI access)
OPENCLAW_GATEWAY_PORT=18789

# Bridge service port
OPENCLAW_BRIDGE_PORT=18790

# Canvas Host port for A2UI visualization
OPENCLAW_CANVAS_PORT=18793

# ============================================================
# File System Access
# ============================================================

# Project directory (read-write access inside container at /project)
# Defaults to current directory when running docker-setup.sh
OPENCLAW_PROJECT_DIR=.

# Host root mount point (read-only access inside container at /host-root)
# Set to / for full host filesystem access, or specific paths like /home
OPENCLAW_HOST_ROOT=/

# Extra volume mounts (comma-separated, format: host:container:mode)
# Example: /data/models:/models:ro,/tmp/scratch:/scratch:rw
OPENCLAW_EXTRA_MOUNTS=

# Use a named volume for /home/node persistence (optional)
# OPENCLAW_HOME_VOLUME=openclaw-home

# ============================================================
# User Permissions
# ============================================================

# User ID for container process (matches host user for file permissions)
# Auto-detected by docker-setup.sh, or set manually
DOCKER_UID=1000

# Group ID for container process
DOCKER_GID=1000

# ============================================================
# GPU Configuration
# ============================================================

# Enable NVIDIA GPU support (requires nvidia-docker2 runtime)
# Set to 1 to enable GPU passthrough
OPENCLAW_ENABLE_GPU=0

# ============================================================
# Sandbox Browser (noVNC Visual Access)
# ============================================================

# Sandbox browser image name
OPENCLAW_SANDBOX_BROWSER_IMAGE=openclaw-sandbox-browser:local

# Chrome DevTools Protocol port
OPENCLAW_BROWSER_CDP_PORT=9222

# VNC direct access port
OPENCLAW_BROWSER_VNC_PORT=5900

# noVNC web interface port (access at http://localhost:6080/vnc.html)
OPENCLAW_BROWSER_NOVNC_PORT=6080

# Enable noVNC web interface (1 = enabled, 0 = disabled)
OPENCLAW_BROWSER_ENABLE_NOVNC=1

# Run browser in headless mode (0 = visible via VNC, 1 = headless)
OPENCLAW_BROWSER_HEADLESS=0

# Start sandbox browser automatically with gateway
OPENCLAW_START_BROWSER=0

# CDP host for gateway to connect to sandbox browser
# Set to 'openclaw-sandbox-browser' when using compose network
OPENCLAW_BROWSER_CDP_HOST=

# ============================================================
# Docker Images
# ============================================================

# Main OpenClaw image
OPENCLAW_IMAGE=openclaw:local

# Extra apt packages to install during build (space-separated)
OPENCLAW_DOCKER_APT_PACKAGES=

# ============================================================
# Claude/AI Provider Authentication
# ============================================================

# Claude AI session key (from claude.ai cookies)
# CLAUDE_AI_SESSION_KEY=

# Claude Web session key
# CLAUDE_WEB_SESSION_KEY=

# Claude Web cookie (full cookie string)
# CLAUDE_WEB_COOKIE=

# ============================================================
# Twilio Configuration (for WhatsApp via Twilio)
# ============================================================

# Copy to .env and fill with your Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+17343367101

# ============================================================
# Quick Start Commands
# ============================================================
#
# 1. Basic setup (no GPU):
#    ./docker-setup.sh
#
# 2. With GPU support:
#    OPENCLAW_ENABLE_GPU=1 ./docker-setup.sh
#
# 3. Start with visual browser:
#    OPENCLAW_START_BROWSER=1 ./docker-setup.sh
#
# 4. Full GUI setup (GPU + Browser):
#    OPENCLAW_ENABLE_GPU=1 OPENCLAW_START_BROWSER=1 ./docker-setup.sh
#
# 5. Access URLs after startup:
#    - Control UI:    http://localhost:18789
#    - Canvas Host:   http://localhost:18793
#    - noVNC Browser: http://localhost:6080/vnc.html
#
# 6. Manually start sandbox browser:
#    docker compose --profile browser up -d openclaw-sandbox-browser
#
# 7. View logs:
#    docker compose logs -f openclaw-gateway
#
# ============================================================
